# -----------------------------------------------------------------------------
# AgriWing Platform - Environment Variables Template (.env.example)
# Copy this file to '.env.local' to configure your local keys
# -----------------------------------------------------------------------------

# Application Settings
VITE_APP_TITLE="AgriWing - Precision Drone Agriculture"
VITE_PORT=3000

# Google Gemini AI Advisory & Diagnostic API (For future AI crop diagnostics & assistant)
# Get your API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=""

# Backend API Endpoint (For future REST / GraphQL server)
# VITE_API_BASE_URL="http://localhost:5000/api/v1"

# Weather & Agromet Telemetry API (e.g., OpenWeatherMap, IMD Mausam)
# VITE_WEATHER_API_KEY=""
# VITE_WEATHER_API_URL="https://api.openweathermap.org/data/2.5"

# GIS & Satellite Mapping Tiles (e.g., Mapbox, Sentinel Hub)
# VITE_MAPBOX_ACCESS_TOKEN=""

# Farmer SMS & WhatsApp Notification Gateway (e.g., Twilio, MSG91)
# VITE_SMS_GATEWAY_API_KEY=""
